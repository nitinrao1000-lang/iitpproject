# Copy this file to .env and add newly generated keys there.
# Never commit .env or paste live credentials into this file.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Can select model here.
GROQ_MODEL=openai/gpt-oss-20b
QWEN_MODEL=qwen/qwen3.8-27b
OPENROUTER_MODEL=openrouter/free

# Production server configuration.
PORT=5000
HOST=127.0.0.1
LOG_LEVEL=INFO
